# ---------------------------------------------------------------------------
# multi-source-data-scout environment configuration (all values are OPTIONAL).
# Copy this file to `.env` and adjust as needed:
#   cp .env.example .env
# ---------------------------------------------------------------------------

# GROQ_API_KEY
#   Optional. Only used to power the LLM-assisted run summary step.
#   If this key is NOT set, the pipeline logs
#   "LLM summary skipped (no API key configured)" and runs identically
#   otherwise — no other behaviour changes.
#   Grab a free key at https://console.groq.com
GROQ_API_KEY=

# SCOUT_LLM_SUMMARY
#   Extra override if you want to keep the key in the env but disable the
#   summary step: set SCOUT_LLM_SUMMARY=0. Defaults to enabled when the key
#   is present.
# SCOUT_LLM_SUMMARY=1

# SCOUT_API_LOOKUP_LIMIT
#   Optional. Max Open Library enrichment lookups per pipeline run. Keeps the
#   pipeline polite to the public API on first runs. Default: 150.
# SCOUT_API_LOOKUP_LIMIT=150

# SCOUT_ERROR_THRESHOLD
#   Optional. Fraction of failed rows tolerated before run_pipeline.py exits
#   non-zero (used by CI as a build gate). Default: 0.05 (i.e. >5% fails the
#   build).
# SCOUT_ERROR_THRESHOLD=0.05